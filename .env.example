# Configurations APIs externes
OPENWEATHER_API_KEY=votre_cle_openweather
AQICN_API_KEY=votre_cle_aqicn
TOMTOM_API_KEY=votre_cle_tomtom

# Configuration Supabase (Base de données)
SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_KEY=votre_cle_anon_ou_service
DB_PASSWORD=votre_mot_de_passe_bdd

# Configuration Scaleway Object Storage (Data Lake)
S3_ACCESS_KEY=votre_access_key
S3_SECRET_KEY=votre_secret_key
S3_BUCKET_NAME=nom_du_bucket

# Options de collecte
COLLECTION_INTERVAL=60
VALIDATION_HOURS=24
VALIDATION_STRICT=false
